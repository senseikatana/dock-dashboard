{
  "name": "dock-dashboard",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:cf": "tsc -b && VITE_BASE_PATH=/apps/dock-dashboard/ vite build",
    "build:pages": "tsc -b && VITE_AUTH_API_URL=https://dock-dashboard.senseikatanacom.workers.dev/apps/dock-dashboard/api VITE_AVATAR_API_URL=https://dock-dashboard.senseikatanacom.workers.dev/apps/dock-dashboard/api vite build --outDir dist-pages && printf '/* /index.html 200\\n' > dist-pages/_redirects",
    "deploy:cf": "bun run build:cf && wrangler deploy --config workers/dock-dashboard/wrangler.jsonc",
    "deploy:pages": "bun run build:pages && wrangler pages deploy dist-pages --project-name dock-dashboard --branch main --commit-dirty=true",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "bun check",
    "seed": "bun scripts/seed-firestore.mjs",
    "purge": "bun scripts/purge-firestore.mjs",
    "auth:users": "bun scripts/create-auth-users.mjs",
    "auth:sync-roles": "bun scripts/set-role-claims.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "chart.js": "^4.6.1",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
